// --- variable const---

#include <iostream>
using namespace std;

int main() {
    const double Pi = 3.14159;
    const int Light = 299792; // Valor real aprox. de la velocidad de la luz en km/s
    const int Width = 1920;
    const int Height = 1080;

    cout << "Pi: " << Pi << endl;
    cout << "Light: " << Light << " km/s" << endl;
    cout << "Width: " << Width << " px" << endl;
    cout << "Height: " << Height << " px" << endl;

    return 0;
}
